    "aes-128-ctr": "AES-128",
    "aes-128-ecb": "AES-128",
    "aes-256-cbc": "AES-256",
    "aes-256-gcm": "AES-256",
    "aes-256-ctr": "AES-256",
    "aes-192-cbc": "AES-192",
    "aes-192-gcm": "AES-192",
    "des-ede3-cbc": "3DES",
    "des-ede3": "3DES",
    "des-cbc": "DES",
    "des-ecb": "DES",
    "rc4": "RC4",
    "chacha20-poly1305": "CHACHA20"
   },
   "map_group": "alg"
  },
  {
