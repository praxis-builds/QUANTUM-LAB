   "files": [
    ".js",
    ".mjs",
    ".cjs",
    ".ts",
    ".tsx",
    ".jsx"
   ],
   "pattern": "create(?:Cipheriv|Decipheriv|Cipher)\\(\\s*['\\\"](?P<alg>aes-(?:128|192|256)-(?:cbc|gcm|ctr|ecb)|des-ede3-cbc|des-ede3|des-cbc|des-ecb|rc4|chacha20-poly1305)['\\\"]",
