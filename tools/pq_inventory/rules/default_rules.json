   "algorithm": "EC"
  },
  {
   "id": "js-hash",
   "description": "hash function",
   "files": [
    ".js",
    ".mjs",
    ".cjs",
    ".ts",
    ".tsx",
    ".jsx"
   ],
   "pattern": "create(?:Hash|Hmac)\\(\\s*['\\\"](?P<alg>md5|sha1|sha256|sha384|sha512)['\\\"]",
   "flags": "i",
   "algorithm_map": {
    "md5": "MD5",
    "sha1": "SHA-1",
    "sha-1": "SHA-1",
    "sha224": "SHA-224",
    "sha256": "SHA-256",
    "sha-256": "SHA-256",
    "sha384": "SHA-384",
    "sha-384": "SHA-384",
    "sha512": "SHA-512",
    "sha-512": "SHA-512",
    "sha3_256": "SHA-3",
    "sha3-256": "SHA-3"
   },
   "map_group": "alg"
  },
  {
   "id": "js-cipher",
