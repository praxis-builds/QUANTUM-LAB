{
 "version": 1,
 "description": "Default pq_inventory rules. Add your own in a separate JSON file and pass --rules.",
 "rules": [
  {
   "id": "py-rsa-generate",
   "description": "RSA key generation",
   "files": [
    ".py"
   ],
   "pattern": "rsa\\.generate_private_key\\([^)]*?key_size\\s*=\\s*(?P<bits>\\d+)",
   "algorithm": "RSA",
   "key_size_group": "bits"
  },
  {
   "id": "py-rsa-generate-pycryptodome",
   "description": "RSA key generation (PyCryptodome)",
   "files": [
    ".py"
   ],
   "pattern": "\\bRSA\\.generate\\(\\s*(?P<bits>\\d+)",
   "algorithm": "RSA",
   "key_size_group": "bits"
  },
  {
   "id": "py-rsa-padding",
   "description": "RSA encryption/signature padding",
   "files": [
    ".py"
   ],
   "pattern": "padding\\.(?:OAEP|PKCS1v15|PSS)\\b",
   "algorithm": "RSA"
  },
  {
   "id": "py-ec-generate",
   "description": "elliptic-curve key",
   "files": [
    ".py"
   ],
   "pattern": "\\bec\\.(?:generate_private_key|derive_private_key)\\(|\\bec\\.SECP(?:256R1|384R1|521R1|256K1)\\b",
   "algorithm": "EC"
  },
  {
   "id": "py-ecdsa",
   "description": "ECDSA signature",
   "files": [
    ".py"
   ],
   "pattern": "\\bec\\.ECDSA\\(|\\bECC\\.generate\\(|\\bDSS\\.new\\(",
   "algorithm": "ECDSA"
  },
  {
   "id": "py-ed25519",
   "description": "Ed25519 signature key",
   "files": [
    ".py"
   ],
   "pattern": "\\bEd25519PrivateKey\\b|\\bEd448PrivateKey\\b",
   "algorithm": "EdDSA"
  },
  {
   "id": "py-x25519",
   "description": "X25519 key agreement",
   "files": [
    ".py"
   ],
   "pattern": "\\bX25519PrivateKey\\b|\\bX448PrivateKey\\b",
   "algorithm": "X25519"
  },
  {
   "id": "py-dh",
   "description": "Diffie-Hellman",
   "files": [
    ".py"
   ],
   "pattern": "\\bdh\\.generate_parameters\\(|\\bdh\\.DHParameterNumbers\\(",
   "algorithm": "DH"
  },
  {
   "id": "py-dsa",
   "description": "DSA key",
   "files": [
    ".py"
   ],
   "pattern": "\\bdsa\\.generate_private_key\\(|\\bDSA\\.generate\\(",
   "algorithm": "DSA"
  },
  {
   "id": "py-hashlib",
   "description": "hash function",
   "files": [
    ".py"
   ],
   "pattern": "\\bhashlib\\.(?P<alg>md5|sha1|sha224|sha256|sha384|sha512|sha3_256)\\s*\\(",
   "algorithm_map": {
    "md5": "MD5",
    "sha1": "SHA-1",
    "sha-1": "SHA-1",
    "sha224": "SHA-224",
    "sha256": "SHA-256",
    "sha-256": "SHA-256",
    "sha384": "SHA-384",
    "sha-384": "SHA-384",
    "sha512": "SHA-512",
    "sha-512": "SHA-512",
    "sha3_256": "SHA-3",
    "sha3-256": "SHA-3"
   },
   "map_group": "alg"
  },
  {
   "id": "py-hashlib-new",
   "description": "hash function",
   "files": [
    ".py"
   ],
   "pattern": "\\bhashlib\\.new\\(\\s*['\\\"](?P<alg>md5|sha1|sha256|sha512)['\\\"]",
   "flags": "i",
   "algorithm_map": {
    "md5": "MD5",
    "sha1": "SHA-1",
    "sha-1": "SHA-1",
    "sha224": "SHA-224",
    "sha256": "SHA-256",
    "sha-256": "SHA-256",
    "sha384": "SHA-384",
    "sha-384": "SHA-384",
    "sha512": "SHA-512",
    "sha-512": "SHA-512",
    "sha3_256": "SHA-3",
    "sha3-256": "SHA-3"
   },
   "map_group": "alg"
  },
  {
   "id": "py-hashes-class",
   "description": "hash function",
   "files": [
    ".py"
   ],
   "pattern": "\\bhashes\\.(?P<alg>MD5|SHA1|SHA224|SHA256|SHA384|SHA512)\\(",
   "flags": "i",
   "algorithm_map": {
    "md5": "MD5",
    "sha1": "SHA-1",
    "sha-1": "SHA-1",
    "sha224": "SHA-224",
    "sha256": "SHA-256",
    "sha-256": "SHA-256",
    "sha384": "SHA-384",
    "sha-384": "SHA-384",
    "sha512": "SHA-512",
    "sha-512": "SHA-512",
    "sha3_256": "SHA-3",
    "sha3-256": "SHA-3"
   },
   "map_group": "alg"
  },
  {
   "id": "py-aes-cryptography",
   "description": "AES with an explicit key length",
   "files": [
    ".py"
   ],
   "pattern": "algorithms\\.AES(?P<bits>128|256)\\(",
   "algorithm_map": {
    "128": "AES-128",
    "256": "AES-256"
   },
   "map_group": "bits"
  },
  {
   "id": "py-aes-keylen",
   "description": "AES key generated with an explicit length",
   "files": [
    ".py"
   ],
   "pattern": "AESGCM\\.generate_key\\(\\s*bit_length\\s*=\\s*(?P<bits>128|192|256)",
   "algorithm_map": {
    "128": "AES-128",
    "192": "AES-192",
    "256": "AES-256"
   },
   "map_group": "bits"
  },
  {
   "id": "py-3des",
   "description": "3DES",
   "files": [
    ".py"
   ],
   "pattern": "\\b(?:DES3|TripleDES)\\.new\\(|algorithms\\.TripleDES\\(",
   "algorithm": "3DES"
  },
  {
   "id": "py-des",
   "description": "single DES",
   "files": [
    ".py"
   ],
   "pattern": "\\bDES\\.new\\(",
   "algorithm": "DES"
  },
  {
   "id": "py-arc4",
   "description": "RC4",
   "files": [
    ".py"
   ],
   "pattern": "\\bARC4\\.new\\(|algorithms\\.ARC4\\(",
   "algorithm": "RC4"
  },
  {
   "id": "js-rsa-keypair",
   "description": "RSA key pair",
   "files": [
    ".js",
    ".mjs",
    ".cjs",
    ".ts",
    ".tsx",
    ".jsx"
   ],
   "pattern": "generateKeyPair(?:Sync)?\\(\\s*['\\\"]rsa(?:-pss)?['\\\"][^)]*?modulusLength\\s*:\\s*(?P<bits>\\d+)",
   "flags": "i",
   "algorithm": "RSA",
   "key_size_group": "bits"
  },
  {
   "id": "js-ec-keypair",
